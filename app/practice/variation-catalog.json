  {
    "slug": "double-substitution-decoding",
    "problemId": "upstart-double-substitution-decoding",
    "functionName": "decode_double",
    "arguments": [
      "known_ab",
      "known_bc",
      "encrypted"
    ],
    "starter": "def decode_double(known_ab, known_bc, encrypted) -> str:\n    \"\"\"Undo two inferred substitution maps; preserve spaces.\"\"\"\n    # Return the answer; do not print it.\n    raise NotImplementedError(\"Implement decode_double\")\n",
    "testCount": 20,
    "examples": [
      {
        "id": "case-01",
        "name": "Undo both substitutions",
        "args": [
          [
            [
              "abc",
              "bcd"
            ]
          ],
          [
            [
              "bcd",
              "def"
            ]
          ],
          "fed def"
        ],
        "expected": "cba abc",
        "sample": true
      },
      {
        "id": "case-02",
        "name": "Preserve repeated letters and spaces",
        "args": [
          [
            [
              "abc",
              "bcd"
            ]
          ],
          [
            [
              "bcd",
              "def"
            ]
          ],
          "ddd  f"
        ],
        "expected": "aaa  c",
        "sample": true
      },
      {
        "id": "case-03",
        "name": "Empty message",
        "args": [
          [],
          [],
          ""
        ],
        "expected": "",
        "sample": true
      }
    ]
  },
